# web
NEXT_PUBLIC_API_URL=http://localhost:8080

# api
PORT=8080
MONGODB_URI=mongodb://mongo:27017/guardrail
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
POLICY_SERVICE_URL=http://policy:8090
VAULT_URL=http://vault:8100
VAULT_TOKEN=local-vault-token
EVM_RPC_URL=http://anvil:8545
SOLANA_RPC_URL=http://solana:8899
PLANNER=mock
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# PLANNER=anthropic requires both of these. Empty fails closed. Do not commit a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Arena. Cap applies only when a live planner is priced. Kill switch leaves recorded replay running.
ARENA_DAILY_USD_CAP=5
ARENA_KILL_SWITCH=
ARENA_IP_HASH_SALT=arena-local-salt
# Set both to a real per-million token price before PLANNER=anthropic will run on /break-it.
ARENA_USD_PER_MILLION_INPUT=
ARENA_USD_PER_MILLION_OUTPUT=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Must match browser host (include port). Defaults to host of SIWE_URI if unset.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_CHAIN_ID=31337

# vault (demo key holder — not the API)
# EVM_DEMO_PRIVATE_KEY and optional SOLANA_DEMO_SECRET_KEY belong here only.
VAULT_PORT=8100

# policy
POLICY_DEFAULTS_PATH=/config/default-policy.json
